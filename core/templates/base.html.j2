<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=768">
<style>/* COMMON_CSS */
/* CONTENT_CSS */</style></head>
<body><div id="poster" data-deck="{{ deck }}">
  <header class="hero">
    <div class="hero-bg"></div><div class="hero-scrim"></div>
    <div class="hero-top"><div class="eyebrow">全国油价</div></div>
    <div class="hero-inner"><div class="title">{{ hero_title | default('今日油价', true) | e }}</div>
      <div class="sub">全国成品油价格 · 挂牌价参考</div></div>
  </header>
  <main class="deck content-__KIND__">{% autoescape true %}<!-- CONTENT -->{% endautoescape %}</main>
  <footer class="source-footer">
    {% set schedule = adjustment | default({}) %}
    <div class="next" data-status="{{ schedule.get('status', 'missing') | e }}">
      <span class="next-ico" aria-hidden="true">◷</span>
      {% if schedule.get('next_date') %}
      <span>下次调价 <b>{{ schedule.next_date | e }}</b> · {{ schedule.days_text | e }}</span>
      {% else %}
      <span>{{ schedule.get('message', '下次调价信息暂不可用，请刷新数据') | e }}</span>
      {% endif %}
    </div>
    {% if stale_note %}<div class="stale" data-stale="1">{{ stale_note | e }}</div>{% endif %}
    <div class="disc">数据来源：ShowAPI 138-46 / 138-49、东方财富（含历史价格） · 仅供参考，实际以加油站挂牌价为准</div></footer>
</div></body></html>
